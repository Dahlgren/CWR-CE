{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "win-clang-base",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CONAN_INSTALL_ARGS": "--build=missing;-s=compiler.runtime=dynamic;-s=compiler.runtime_version=v143"
      }
    },
    {
      "name": "win-clang-debug",
      "hidden": true,
      "inherits": "win-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-clang-relwithdebinfo",
      "hidden": true,
      "inherits": "win-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "win-clang-release",
      "hidden": true,
      "inherits": "win-clang-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-x64-clang-toolchain",
      "hidden": true,
      "toolchainFile": "${sourceDir}/cmake/toolchains/win-x64-clang.cmake"
    },
    {
      "name": "win-x64-clang-dbg",
      "displayName": "Win x64 Clang Debug",
      "inherits": [
        "win-x64-clang-toolchain",
        "win-clang-debug"
      ],
      "binaryDir": "${sourceDir}/build/win-x64-clang-dbg"
    },
    {
      "name": "win-x64-clang-rwdi",
      "displayName": "Win x64 Clang RelWithDebInfo",
      "inherits": [
        "win-x64-clang-toolchain",
        "win-clang-relwithdebinfo"
      ],
      "binaryDir": "${sourceDir}/build/win-x64-clang-rwdi"
    },
    {
      "name": "win-x64-clang-rel",
      "displayName": "Win x64 Clang Release",
      "inherits": [
        "win-x64-clang-toolchain",
        "win-clang-release"
      ],
      "binaryDir": "${sourceDir}/build/win-x64-clang-rel"
    }
  ]
}
