{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "win-clang-sanitizer",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "CONAN_INSTALL_ARGS": "--build=missing;-s=compiler.runtime=dynamic;-s=compiler.runtime_version=v143"
      }
    },
    {
      "name": "win-x64-clang-san",
      "displayName": "Win x64 Clang ASan+UBSan",
      "inherits": "win-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/win-x64-clang-san",
      "toolchainFile": "${sourceDir}/cmake/toolchains/win-x64-clang-san.cmake"
    },
    {
      "name": "win-x64-clang-fuzz",
      "displayName": "Win x64 Clang libFuzzer + ASan (network)",
      "inherits": "win-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/win-x64-clang-fuzz",
      "toolchainFile": "${sourceDir}/cmake/toolchains/win-x64-clang-fuzz.cmake",
      "cacheVariables": {
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "CONAN_INSTALL_ARGS": "--build=missing;-s=compiler.runtime=static;-s=compiler.runtime_version=v143",
        "POSEIDON_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "linux-clang-sanitizer",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-arm64-clang-san",
      "displayName": "Linux arm64 Clang ASan+UBSan",
      "inherits": "linux-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/linux-arm64-clang-san",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64-clang-san.cmake"
    },
    {
      "name": "linux-arm64-clang-tsan",
      "displayName": "Linux arm64 Clang TSan",
      "inherits": "linux-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/linux-arm64-clang-tsan",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64-clang-tsan.cmake"
    },
    {
      "name": "linux-x64-clang-fuzz",
      "displayName": "Linux x64 Clang libFuzzer + ASan",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux-x64-clang-fuzz",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x64-clang-fuzz.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "POSEIDON_BUILD_FUZZERS": "ON"
      }
    },
    {
      "name": "linux-x64-clang-san",
      "displayName": "Linux x64 Clang ASan+UBSan",
      "inherits": "linux-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/linux-x64-clang-san",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x64-clang-san.cmake"
    },
    {
      "name": "linux-x64-clang-tsan",
      "displayName": "Linux x64 Clang TSan",
      "inherits": "linux-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/linux-x64-clang-tsan",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x64-clang-tsan.cmake"
    },
    {
      "name": "macos-clang-sanitizer",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-arm64-clang-san",
      "displayName": "macOS arm64 Clang ASan+UBSan",
      "inherits": "macos-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/macos-arm64-clang-san",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-arm64-clang-san.cmake"
    },
    {
      "name": "macos-arm64-clang-tsan",
      "displayName": "macOS arm64 Clang TSan",
      "inherits": "macos-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/macos-arm64-clang-tsan",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-arm64-clang-tsan.cmake"
    },
    {
      "name": "macos-x64-clang-san",
      "displayName": "macOS x64 Clang ASan+UBSan",
      "inherits": "macos-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/macos-x64-clang-san",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-x64-clang-san.cmake"
    },
    {
      "name": "macos-x64-clang-tsan",
      "displayName": "macOS x64 Clang TSan",
      "inherits": "macos-clang-sanitizer",
      "binaryDir": "${sourceDir}/build/macos-x64-clang-tsan",
      "toolchainFile": "${sourceDir}/cmake/toolchains/macos-x64-clang-tsan.cmake"
    }
  ]
}
