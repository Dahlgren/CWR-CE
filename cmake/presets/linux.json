{
  "version": 6,
  "include": [
    "base.json"
  ],
  "configurePresets": [
    {
      "name": "linux-clang-debug",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-clang-relwithdebinfo",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-clang-release",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-arm64-clang-toolchain",
      "hidden": true,
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64-clang.cmake"
    },
    {
      "name": "linux-x64-clang-toolchain",
      "hidden": true,
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-x64-clang.cmake"
    },
    {
      "name": "linux-arm64-clang",
      "displayName": "Linux arm64 Clang Debug",
      "inherits": [
        "linux-arm64-clang-toolchain",
        "linux-clang-debug"
      ],
      "binaryDir": "${sourceDir}/build/linux-arm64-clang"
    },
    {
      "name": "linux-arm64-clang-rwdi",
      "displayName": "Linux arm64 Clang RelWithDebInfo",
      "inherits": [
        "linux-arm64-clang-toolchain",
        "linux-clang-relwithdebinfo"
      ],
      "binaryDir": "${sourceDir}/build/linux-arm64-clang-rwdi"
    },
    {
      "name": "linux-arm64-clang-rel",
      "displayName": "Linux arm64 Clang Release",
      "inherits": [
        "linux-arm64-clang-toolchain",
        "linux-clang-release"
      ],
      "binaryDir": "${sourceDir}/build/linux-arm64-clang-rel"
    },
    {
      "name": "linux-x64-clang",
      "displayName": "Linux x64 Clang Debug",
      "inherits": [
        "linux-x64-clang-toolchain",
        "linux-clang-debug"
      ],
      "binaryDir": "${sourceDir}/build/linux-x64-clang"
    },
    {
      "name": "linux-x64-clang-rwdi",
      "displayName": "Linux x64 Clang RelWithDebInfo",
      "inherits": [
        "linux-x64-clang-toolchain",
        "linux-clang-relwithdebinfo"
      ],
      "binaryDir": "${sourceDir}/build/linux-x64-clang-rwdi"
    },
    {
      "name": "linux-x64-steamrt4",
      "displayName": "Linux x64 Steam Runtime 4 RelWithDebInfo",
      "inherits": [
        "linux-x64-clang-toolchain",
        "linux-clang-relwithdebinfo"
      ],
      "binaryDir": "${sourceDir}/build/linux-x64-steamrt4"
    },
    {
      "name": "steamrt4-x64-clang-dbg",
      "displayName": "Steam Runtime 4 x64 Clang Debug",
      "inherits": [
        "linux-x64-clang-toolchain",
        "linux-clang-debug"
      ],
      "binaryDir": "${sourceDir}/build/steamrt4-x64-clang-dbg"
    },
    {
      "name": "steamrt4-x64-clang-rwdi",
      "displayName": "Steam Runtime 4 x64 Clang RelWithDebInfo",
      "inherits": [
        "linux-x64-clang-toolchain",
        "linux-clang-relwithdebinfo"
      ],
      "binaryDir": "${sourceDir}/build/steamrt4-x64-clang-rwdi"
    },
    {
      "name": "steamrt4-x64-clang-rel",
      "displayName": "Steam Runtime 4 x64 Clang Release",
      "inherits": [
        "linux-x64-clang-toolchain",
        "linux-clang-release"
      ],
      "binaryDir": "${sourceDir}/build/steamrt4-x64-clang-rel"
    },
    {
      "name": "linux-x64-clang-rel",
      "displayName": "Linux x64 Clang Release",
      "inherits": [
        "linux-x64-clang-toolchain",
        "linux-clang-release"
      ],
      "binaryDir": "${sourceDir}/build/linux-x64-clang-rel"
    }
  ]
}
